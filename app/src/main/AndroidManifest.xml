<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The lock screen buttons live in a notification. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Puts that notification back after the phone restarts. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Calendar: writes the log as events into the calendars you pick (Google's sync uploads them)
         and reads planned events. Only ever changes events the app made itself. Asked for in Settings. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <!-- Internet: used only to send your log to Toggl Track (api.track.toggl.com), when you turn that on in Settings.
         No updater and no install permission here: the Widget Updater app does the updating. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- The Widget Updater, which checks for new builds and installs them. -->
    <queries>
        <package android:name="com.jono.widgetupdater" />
    </queries>

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Makes the widget's long-press menu show a settings entry that opens this screen. -->
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <activity android:name=".TimelineActivity" android:exported="false" />
        <activity android:name=".ManageActivity" android:exported="false" />
        <!-- Daylio import. Kept alive on rotation so a long import isn't restarted. -->
        <activity
            android:name=".ImportActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:exported="false" />

        <!-- Expand panel: floats over the home screen when you tap a small widget. -->
        <activity
            android:name=".PanelActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:theme="@style/Panel" />

        <!-- The 📝 check-in box. The keyboard's mic does the voice typing, so this app needs no mic access. -->
        <activity
            android:name=".NoteActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:theme="@style/Panel" />

        <!-- The activity buttons' ＋: say what you're doing in your own words. -->
        <activity
            android:name=".FreeWriteActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:theme="@style/Panel"
            android:windowSoftInputMode="stateAlwaysVisible|adjustResize" />

        <!-- Lets the Widget Updater find this app and tell it when a new build is out. -->
        <receiver
            android:name=".UpdateStatusReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.jono.widgets.UPDATABLE" />
            </intent-filter>
            <meta-data
                android:name="com.jono.widgets.repo"
                android:value="jonomf/now-widget" />
            <meta-data
                android:name="com.jono.widgets.asset"
                android:value="now-widget.apk" />
        </receiver>

        <receiver
            android:name=".NowWidget"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info" />
        </receiver>

        <receiver
            android:name=".BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <!-- Writes the Obsidian notes about a minute after the last change (plain JobScheduler). -->
        <service
            android:name=".ExportJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <!-- Writes the calendar events about a minute after the last change. -->
        <service
            android:name=".CalendarJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <!-- Sends the log to Toggl at the next attempt time (needs a network). -->
        <service
            android:name=".TogglJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <!-- Redraws the widget when a planned event starts or ends (its activity gets the first button). -->
        <service
            android:name=".NudgeJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <!-- Redraws the widget when the check-in flow (where / who / feeling) times out. -->
        <service
            android:name=".FlowJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <!-- App-icon long-press "Claude session" shortcut (ClaudeLink.syncShortcut) opens this. -->
        <activity
            android:name=".ClaudeLinkActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay" />
    </application>
</manifest>
