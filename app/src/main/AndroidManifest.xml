<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The lock screen buttons live in a notification. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Puts that notification back after the phone restarts. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- The Widget Updater, which checks for new builds and installs them. -->
    <queries>
        <package android:name="com.jono.widgetupdater" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Makes the widget's long-press menu show a settings entry that opens this screen. -->
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <activity android:name=".TimelineActivity" android:exported="false" />
        <activity android:name=".ManageActivity" android:exported="false" />

        <!-- Expand panel: floats over the home screen when you tap a small widget. -->
        <activity
            android:name=".PanelActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:theme="@style/Panel" />

        <!-- The note box. The keyboard's mic does the voice typing, so this app needs no mic access. -->
        <activity
            android:name=".NoteActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:theme="@style/Panel" />

        <!-- Lets the Widget Updater find this app and tell it when a new build is out. -->
        <receiver
            android:name=".UpdateStatusReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.jono.widgets.UPDATABLE" />
            </intent-filter>
            <meta-data
                android:name="com.jono.widgets.repo"
                android:value="jonomf/now-widget" />
            <meta-data
                android:name="com.jono.widgets.asset"
                android:value="now-widget.apk" />
        </receiver>

        <receiver
            android:name=".NowWidget"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info" />
        </receiver>

        <receiver
            android:name=".BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
