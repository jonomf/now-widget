<?xml version="1.0" encoding="utf-8"?>
<!-- 1×1: what you're doing and for how long. Tap to change it; the corner button adds a note.
     After a switch it asks where / who / how you feel, with the default as a chip. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg">

    <LinearLayout
        android:id="@+id/head"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="4dp">

        <TextView
            android:id="@+id/cur_emoji"
            style="@style/CurEmoji" />

        <Chronometer
            android:id="@+id/cur_elapsed"
            style="@style/Elapsed"
            android:layout_marginTop="2dp" />

        <TextView
            android:id="@+id/cur_name"
            style="@style/CurName"
            android:layout_marginTop="1dp"
            android:gravity="center_horizontal"
            android:textSize="11sp" />

        <!-- The check-in flow: the step's default ("📍 Loft?"). Tap to accept it. -->
        <TextView
            android:id="@+id/flow_chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:background="@drawable/slot_on"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:paddingStart="6dp"
            android:paddingTop="4dp"
            android:paddingEnd="6dp"
            android:paddingBottom="4dp"
            android:singleLine="true"
            android:textColor="@color/widget_text"
            android:textSize="11sp"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/btn_note"
        style="@style/NoteButton"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_gravity="top|end"
        android:layout_margin="3dp"
        android:textSize="11sp" />

    <ImageView
        android:id="@+id/claude"
        style="@style/ClaudeLink" />

    <ImageView
        android:id="@+id/update_symbol"
        style="@style/UpdateSymbol"
        android:layout_gravity="top|start"
        android:layout_margin="3dp" />
</FrameLayout>
