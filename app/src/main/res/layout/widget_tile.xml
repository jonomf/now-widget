<?xml version="1.0" encoding="utf-8"?>
<!-- 1×1: what you're doing and for how long. Tap to change it; the corner button adds a note.
     After a switch it asks where / who / how you feel, with the default as a chip. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg">

    <LinearLayout
        android:id="@+id/head"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="4dp">

        <TextView
            android:id="@+id/cur_emoji"
            style="@style/CurEmoji" />

        <Chronometer
            android:id="@+id/cur_elapsed"
            style="@style/Elapsed"
            android:layout_marginTop="2dp" />

        <TextView
            android:id="@+id/cur_name"
            style="@style/CurName"
            android:layout_marginTop="1dp"
            android:gravity="center_horizontal"
            android:textSize="11sp" />

    </LinearLayout>

    <!-- The check-in flow: the whole lower half accepts the step's default ("📍 Loft?"); the top
         half is still the head (opens the panel with the whole step). Hidden outside the flow. -->
    <LinearLayout
        android:id="@+id/flow_hit"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/flow_hit_area"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="3dp">

            <TextView
                android:id="@+id/flow_chip"
                style="@style/FlowButton"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/slot_on"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/btn_note"
        style="@style/NoteButton"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_gravity="top|end"
        android:layout_margin="3dp"
        android:textSize="11sp" />

    <ImageView
        android:id="@+id/claude"
        style="@style/ClaudeLink" />

    <ImageView
        android:id="@+id/update_symbol"
        style="@style/UpdateSymbol"
        android:layout_gravity="top|start"
        android:layout_margin="3dp" />
</FrameLayout>
