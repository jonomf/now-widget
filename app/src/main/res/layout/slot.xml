<?xml version="1.0" encoding="utf-8"?>
<!-- One activity button. Tap to switch to it; tap the current one to move its start back. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/slot_root"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_margin="2dp"
    android:layout_weight="1"
    android:background="@drawable/slot_off"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingStart="2dp"
    android:paddingEnd="2dp">

    <TextView
        android:id="@+id/slot_emoji"
        style="@style/SlotEmoji"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/slot_label"
        style="@style/SlotLabel"
        android:textSize="9.5sp" />
</LinearLayout>
