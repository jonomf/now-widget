<resources>
    <style name="AppTheme" parent="@android:style/Theme.DeviceDefault.DayNight" />

    <!-- Expand panel: floats over the home screen; the biggest widget layout is drawn inside it. -->
    <style name="Panel" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.45</item>
    </style>

    <style name="CurEmoji">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:singleLine">true</item>
        <item name="android:textSize">24sp</item>
        <item name="android:text">☕</item>
    </style>

    <style name="CurName">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:ellipsize">end</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:singleLine">true</item>
        <item name="android:textColor">@color/widget_text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:text">Coffee</item>
    </style>

    <style name="Elapsed">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:singleLine">true</item>
        <item name="android:textColor">@color/accent_text</item>
        <item name="android:textSize">11sp</item>
    </style>

    <style name="Since">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:ellipsize">end</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:singleLine">true</item>
        <item name="android:textColor">@color/widget_subtext</item>
        <item name="android:textSize">11sp</item>
    </style>

    <style name="NoteButton">
        <item name="android:background">@drawable/slot_off</item>
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:singleLine">true</item>
        <item name="android:text">📝</item>
        <item name="android:textColor">@color/widget_text</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="UpdateSymbol">
        <item name="android:layout_width">16dp</item>
        <item name="android:layout_height">16dp</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:background">@drawable/update_bg</item>
        <item name="android:padding">2dp</item>
        <item name="android:src">@drawable/ic_update</item>
        <item name="android:contentDescription">Update available</item>
        <item name="android:visibility">gone</item>
    </style>

    <style name="SlotEmoji">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:singleLine">true</item>
    </style>

    <style name="SlotLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:ellipsize">end</item>
        <item name="android:gravity">center_horizontal</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:singleLine">true</item>
        <item name="android:textColor">@color/widget_text</item>
    </style>

    <style name="ClaudeLink">
        <item name="android:layout_width">16dp</item>
        <item name="android:layout_height">16dp</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:padding">1dp</item>
        <item name="android:src">@drawable/ic_claude</item>
        <item name="android:contentDescription">Claude session</item>
        <item name="android:visibility">gone</item>
    </style>
</resources>
